  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "typescript": "^5.5.4",
